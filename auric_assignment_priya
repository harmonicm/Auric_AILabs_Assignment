"val\" / \"labels\"\n\n# 2. Check for best available weights\ncandidate_weights = [\n    \"/kaggle/working/yolov8_p2_best.pt\",\n    \"/kaggle/working/experiments/clean_yolov8m_sliced/weights/best.pt\",\n    \"/kaggle/working/saved_models/clean_yolov8m_best.pt\",\n    \"/kaggle/working/experiments/run2_sliced_yolov8s_640/weights/best.pt\"\n]\n\nmodel_path = None\nfor p in candidate_weights:\n    if os.path.exists(p):\n        model_path = p\n        break\n\nif not model_path:\n    print(\"Warning: No pre-existing local sliced checkpoint found. Utilizing base YOLO checkpoint.\")\n    model_path = \"yolov8m.pt\"\n\nprint(f\"Using weights from: {model_path}\")\n\n# 3. Initialize SAHI AutoDetectionModel\ndetection_model = AutoDetectionModel.from_pretrained(\n    model_type='yolov8',\n    model_path=model_path,\n    confidence_threshold=0.15,\n    device=\"cuda:0\" if torch.cuda.is_available() else \"cpu\"\n)\n\nCLASS_NAMES = [\"Cargo Truck\", \"Truck w/Box\", \"Truck w/Flatbed\", \"Truck Tractor\", \"Truck w/Liquid\"]\n\n# 4. Run Sliced-Aided Hyper Inference (SAHI) on validation set\nval_images = sorted(list(VAL_IMG_DIR.glob(\"*.jpg\")) + list(VAL_IMG_DIR.glob(\"*.png\")))\nprint(f\"Executing SAHI evaluation over {len(val_images)} full validation scenes...\")\n\npred_boxes_all = []\ngt_boxes_all = []\n\nfor img_p in val_images:\n    lbl_p = VAL_LBL_DIR / f\"{img_p.stem}.txt\"\n    img = cv2.imread(str(img_p))\n    if img is None:\n        continue\n    h, w, _ = img.shape\n    \n    # Read Ground Truth\n    gts = []\n    if lbl_p.exists():\n        with open(lbl_p, \"r\") as f:\n            for line in f:\n                parts = line.strip().split()\n                if len(parts) >= 5:\n                    cid = int(parts[0])\n                    xc, yc, bw, bh = map(float, parts[1:5])\n                    x1 = (xc - bw / 2.0) * w\n                    y1 = (yc - bh / 2.0) * h\n                    x2 = (xc + bw / 2.0) * w\n                    y2 = (yc + bh / 2.0) * h\n                    gts.append([cid, x1, y1, x2, y2])\n    gt_boxes_all.append(gts)\n    \n    # Run SAHI with 640x640 sliding slice and 25% overlap\n    result = get_sliced_prediction(\n        str(img_p),\n        detection_model,\n        slice_height=640,\n        slice_width=640,\n        overlap_height_ratio=0.25,\n        overlap_width_ratio=0.25,\n        postprocess_type=\"NMS\",\n        postprocess_match_metric=\"IOU\",\n        postprocess_match_threshold=0.45\n    )\n    \n    preds = []\n    for pred in result.object_prediction_list:\n        cat_id = pred.category.id\n        bbox = pred.bbox.to_xyxy()\n        conf = pred.score.value\n        preds.append([cat_id, conf, bbox[0], bbox[1], bbox[2], bbox[3]])\n    pred_boxes_all.append(preds)\n\nprint(\"SAHI inference complete across all validation scenes.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os\nimport glob\nimport cv2\nimport yaml\nimport numpy as np\n\nRAW_TRAIN_IMG = \"/kaggle/input/dataset/train/images\"  # Update to your raw train image path\nRAW_TRAIN_LBL = \"/kaggle/input/dataset/train/labels\"  # Update to your raw train label path\nRAW_VAL_IMG   = \"/kaggle/input/dataset/valid/images\"  # Update to your raw val image path\nRAW_VAL_LBL   = \"/kaggle/input/dataset/valid/labels\"  # Update to your raw val label path\n\nOUT_DIR = \"/kaggle/working/tiled_dataset\"\nTILE_SIZE = 640\nOVERLAP = 0.20\nSTEP = int(TILE_SIZE * (1 - OVERLAP))\n\ndef slice_dataset(img_dir, lbl_dir, split=\"train\", empty_keep_ratio=0.08):\n    out_img_dir = os.path.join(OUT_DIR, split, \"images\")\n    out_lbl_dir = os.path.join(OUT_DIR, split, \"labels\")\n    os.makedirs(out_img_dir, exist_ok=True)\n    os.makedirs(out_lbl_dir, exist_ok=True)\n\n    img_paths = glob.glob(os.path.join(img_dir, \"*.*\"))\n    tile_count = 0\n\n    for img_path in img_paths:\n        base_name = os.path.splitext(os.path.basename(img_path))[0]\n        lbl_path = os.path.join(lbl_dir, base_name + \".txt\")\n\n        img = cv2.imread(img_path)\n        if img is None:\n            continue\n        h, w, _ = img.shape\n\n        boxes = []\n        if os.path.exists(lbl_path):\n            with open(lbl_path, \"r\") as f:\n                for line in f:\n                    parts = line.strip().split()\n                    if len(parts) >= 5:\n                        cls_id = int(parts[0])\n                        xc, yc, bw, bh = [float(x) for x in parts[1:5]]\n                        # Convert normalized to absolute pixel space\n                        x1 = (xc - bw / 2) * w\n                        y1 = (yc - bh / 2) * h\n                        x2 = (xc + bw / 2) * w\n                        y2 = (yc + bh / 2) * h\n                        boxes.append([cls_id, x1, y1, x2, y2])\n\n        boxes = np.array(boxes) if len(boxes) > 0 else np.empty((0, 5))\n\n        # Sliding window over the scene\n        for y in range(0, max(1, h - TILE_SIZE + 1), STEP):\n            for x in range(0, max(1, w - TILE_SIZE + 1), STEP):\n                x_end = min(x + TILE_SIZE, w)\n                y_end = min(y + TILE_SIZE, h)\n                x_start = max(0, x_end - TILE_SIZE)\n                y_start = max(0, y_end - TILE_SIZE)\n\n                tile = img[y_start:y_end, x_start:x_end]\n                tile_labels = []\n\n                if len(boxes) > 0:\n                    # Find boxes whose centers fall inside this tile\n                    box_centers_x = (boxes[:, 1] + boxes[:, 3]) / 2\n                    box_centers_y = (boxes[:, 2] + boxes[:, 4]) / 2\n\n                    inside = (box_centers_x >= x_start) & (box_centers_x < x_end) & \\\n                             (box_centers_y >= y_start) & (box_centers_y < y_end)\n\n                    for b in boxes[inside]:\n                        cls_id = int(b[0])\n                        bx1 = max(0, b[1] - x_start)\n                        by1 = max(0, b[2] - y_start)\n                    