)) + list(img_dir.glob(\"*.jpg\")))\n        \n        for img_path in img_files:\n            lbl_path = lbl_dir / f\"{img_path.stem}.txt\"\n            if not lbl_path.exists():\n                continue\n                \n            img = cv2.imread(str(img_path))\n            if img is None:\n                continue\n            h, w, _ = img.shape\n            \n            with open(lbl_path, \"r\") as f:\n                for line in f:\n                    parts = line.strip().split()\n                    if len(parts) >= 5:\n                        cls_id = int(parts[0])\n                        xc, yc, bw, bh = map(float, parts[1:5])\n                        \n                        # Convert normalized bbox to absolute pixel coordinates\n                        x1 = max(0, int((xc - bw / 2.0) * w))\n                        y1 = max(0, int((yc - bh / 2.0) * h))\n                        x2 = min(w, int((xc + bw / 2.0) * w))\n                        y2 = min(h, int((yc + bh / 2.0) * h))\n                        \n                        if (x2 - x1) >= 4 and (y2 - y1) >= 4:\n                            crop = img[y1:y2, x1:x2]\n                            crop = cv2.cvtColor(crop, cv2.COLOR_BGR2RGB)\n                            self.crops.append(crop)\n                            self.labels.append(cls_id)\n                            \n    def __len__(self):\n        return len(self.crops)\n        \n    def __getitem__(self, idx):\n        crop = self.crops[idx]\n        label = self.labels[idx]\n        if self.transform:\n            crop = self.transform(crop)\n        return crop, label\n\n# 2. Preprocessing pipeline for small vehicle crops\ntransform_pipeline = transforms.Compose([\n    transforms.ToPILImage(),\n    transforms.Resize((64, 64)),\n    transforms.ToTensor(),\n    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n])\n\nprint(\"Extracting ground-truth crops for Section 5.1 Oracle Experiment...\")\ntrain_dataset = OracleVehicleDataset(\"train\", transform=transform_pipeline)\nval_dataset = OracleVehicleDataset(\"val\", transform=transform_pipeline)\n\nprint(f\"Extracted {len(train_dataset)} Train crops and {len(val_dataset)} Val crops.\")\n\ntrain_loader = DataLoader(train_dataset, batch_size=64, shuffle=True, num_workers=2)\nval_loader = DataLoader(val_dataset, batch_size=64, shuffle=False, num_workers=2)\n\n# 3. Train an Oracle Classifier (ResNet18 backbone)\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\noracle_classifier = models.resnet18(weights=models.ResNet18_Weights.DEFAULT)\noracle_classifier.fc = nn.Linear(oracle_classifier.fc.in_features, 5)\noracle_classifier = oracle_classifier.to(device)\n\ncriterion = nn.CrossEntropyLoss()\noptimizer = optim.AdamW(oracle_classifier.parameters(), lr=1e-3, weight_decay=1e-4)\n\nprint(\"Training Oracle Classifier on GT crops (10 epochs)...\")\nfor epoch in range(1, 11):\n    oracle_classifier.train()\n    running_loss = 0.0\n    for images, labels in train_loader:\n        images, labels = images.to(device), labels.to(device)\n        optimizer.zero_grad()\n        outputs = oracle_classifier(images)\n        loss = criterion(outputs, labels)\n        loss.backward()\n        optimizer.step()\n        running_loss += loss.item() * images.size(0)\n        \n    epoch_loss = running_loss / len(train_dataset)\n    print(f\"Epoch {epoch}/10 - Loss: {epoch_loss:.4f}\")\n\n# 4. Evaluate Oracle Classification Performance\noracle_classifier.eval()\nall_preds = []\nall_targets = []\nall_probs = []\n\nwith torch.no_grad():\n    for images, labels in val_loader:\n        images = images.to(device)\n        outputs = oracle_classifier(images)\n        probs = torch.softmax(outputs, dim=1).cpu().numpy()\n        preds = np.argmax(probs, axis=1)\n        \n        all_probs.append(probs)\n        all_preds.extend(preds)\n        all_targets.extend(labels.numpy())\n\nall_probs = np.vstack(all_probs)\nall_preds = np.array(all_preds)\nall_targets = np.array(all_targets)\n\ntop1_acc = accuracy_score(all_targets, all_preds)\ntop2_acc = top_k_accuracy_score(all_targets, all_probs, k=2)\n\nprint(\"\\n\" + \"=\" * 65)\nprint(\"SECTION 5.1: ORACLE CLASSIFICATION RESIDUAL RESULTS\")\nprint(\"=\" * 65)\nprint(f\"Oracle Top-1 Classification Accuracy (Zero Loc Error): {top1_acc*100:.2f}%\")\nprint(f\"Oracle Top-2 Classification Accuracy:                 {top2_acc*100:.2f}%\")\nprint(\"-\" * 65)\nprint(classification_report(all_targets, all_preds, target_names=CLASS_NAMES, digits=4))\nprint(\"=\" * 65)\n\n# Save Oracle model weights\ntorch.save(oracle_classifier.state_dict(), \"/kaggle/working/saved_models/oracle_resnet18_best.pt\")\nprint(\"Oracle weights saved to /kaggle/working/saved_models/oracle_resnet18_best.pt\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os\nimport torch\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom torchvision import models, transforms\nfrom torch.utils.data import Dataset, DataLoader\nimport torch.nn as nn\n\nRAW_DATA = Path(\"/kaggle/input/datasets/pannnnnnnn/auric-cv-dataset/CV_Assignment_AAL\")\nCLASS_NAMES = [\"Cargo Truck\", \"Truck w/Box\", \"Truck w/Flatbed\", \"Truck Tractor\", \"Truck w/Liquid\"]\n\n# 1. Dataset with bounding box spatial metadata\nclass DiagnosticVehicleDataset(Dataset):\n    def __init__(self, split_name, transform=None):\n        self.transform = transform\n        self.crops = []\n        self.labels = []\n        self.metadata = []\n        \n        img_dir = RAW_DATA / split_name / \"images\"\n        lbl_dir = RAW_DATA / split_name / \"labels\"\n        img_files = sorted(list(img_dir.glob(\"*.png\")) + list(img_dir.glob(\"*.jpg\")))\n        \n        for img_path in img_files:\n            lbl_path = lbl_dir / f\"{img_path.stem}.txt\"\n            if not lbl_path.exists():\n                continue\n                \n            img_bgr = cv2